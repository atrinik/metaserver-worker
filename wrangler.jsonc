{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atrinik-metaserver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "no_web_socket_compression"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrinik-metaserver",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "RENDEZVOUS_METRICS",
      "dataset": "atrinik_metaserver_rendezvous"
    },
    {
      "binding": "DIRECTORY_METRICS",
      "dataset": "atrinik_metaserver_directory"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DIRECTORY_GENERATIONS",
      "bucket_name": "atrinik-metaserver-directory-generations"
    },
    {
      "binding": "CLASSIC_DIRECTORY_PUBLIC",
      "bucket_name": "atrinik-metaserver-directory-classic"
    },
    {
      "binding": "GAME_DIRECTORY_PUBLIC",
      "bucket_name": "atrinik-metaserver-directory-game"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDEZVOUS",
        "class_name": "RendezvousRoom"
      },
      {
        "name": "DIRECTORY_BUILDER",
        "class_name": "DirectoryBuilder"
      }
    ]
  },
  "exports": {
    "RendezvousRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DirectoryBuilder": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PublisherCoordinator": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "RendezvousCoordinator": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    }
  },
  "ratelimits": [
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DIRECTORY_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "OTP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "UPDATE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLISH_IDENTITY_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "RENDEZVOUS_CLIENT_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "RENDEZVOUS_SERVER_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "SOURCE_TAG_KEY_CURRENT",
      "SOURCE_TAG_KEY_PREVIOUS"
    ]
  },
  "vars": {
    "COMPAT_HOSTNAME": "meta.atrinik.org",
    "PUBLISH_HOSTNAME": "publish.meta.atrinik.org",
    "RENDEZVOUS_HOSTNAME": "rendezvous.meta.atrinik.org",
    "COMPAT_STATUS_ENABLED": "enabled",
    "COMPAT_DIRECTORY_ENABLED": "enabled",
    "COMPAT_OTP_ENABLED": "enabled",
    "COMPAT_UPDATE_ENABLED": "enabled",
    "PUBLISH_ENABLED": "disabled",
    "RENDEZVOUS_ENABLED": "disabled",
    "COMPAT_RENDEZVOUS_ENABLED": "enabled",
    "SOURCE_TAG_KEY_CURRENT_ID": "2026-08-a",
    "SOURCE_TAG_KEY_PREVIOUS_ID": "2026-07-a",
    "LISTING_TTL_SECONDS": "14400",
    "OTP_TTL_SECONDS": "120",
    "STALE_DATA_RETENTION_SECONDS": "18000",
    "ROUTE_DISABLED_RETRY_SECONDS": "300",
    "COMPAT_STATUS_DAILY_LIMIT": "100",
    "COMPAT_DIRECTORY_DAILY_LIMIT": "100",
    "COMPAT_OTP_DAILY_LIMIT": "48",
    "COMPAT_UPDATE_SOURCE_DAILY_LIMIT": "48",
    "COMPAT_UPDATE_SERVER_DAILY_LIMIT": "48",
    "PUBLISH_SERVER_DAILY_LIMIT": "48",
    "COMPAT_RENDEZVOUS_CLIENT_SOURCE_DAILY_LIMIT": "50",
    "COMPAT_RENDEZVOUS_CLIENT_PAIR_DAILY_LIMIT": "10",
    "COMPAT_RENDEZVOUS_SERVER_SOURCE_DAILY_LIMIT": "50",
    "COMPAT_RENDEZVOUS_SERVER_DAILY_LIMIT": "50",
    "RENDEZVOUS_CLIENT_ROLLING_LIMIT": "50",
    "RENDEZVOUS_ACTIVE_CLIENT_LIMIT": "16",
    "RENDEZVOUS_CLIENT_SESSION_SECONDS": "15",
    "DIRECTORY_REFRESH_LEAD_SECONDS": "3600"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  }
}
