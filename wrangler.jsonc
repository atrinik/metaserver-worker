{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atrinik-metaserver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "no_web_socket_compression"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrinik-metaserver",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "RENDEZVOUS_METRICS",
      "dataset": "atrinik_metaserver_rendezvous"
    },
    {
      "binding": "DIRECTORY_METRICS",
      "dataset": "atrinik_metaserver_directory"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DIRECTORY_GENERATIONS",
      "bucket_name": "atrinik-metaserver-directory-generations"
    },
    {
      "binding": "CLASSIC_DIRECTORY_PUBLIC",
      "bucket_name": "atrinik-metaserver-directory-classic"
    },
    {
      "binding": "GAME_DIRECTORY_PUBLIC",
      "bucket_name": "atrinik-metaserver-directory-game"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDEZVOUS",
        "class_name": "RendezvousRoom"
      },
      {
        "name": "DIRECTORY_BUILDER",
        "class_name": "DirectoryBuilder"
      }
    ]
  },
  "exports": {
    "RendezvousRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DirectoryBuilder": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PublisherCoordinator": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "RendezvousCoordinator": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    }
  },
  "ratelimits": [
    {
      "name": "PUBLISH_IDENTITY_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "RENDEZVOUS_SERVER_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "DIRECTORY_CACHE_PURGE_TOKEN",
      "SOURCE_TAG_KEY_CURRENT",
      "SOURCE_TAG_KEY_PREVIOUS"
    ]
  },
  "vars": {
    "DIRECTORY_CACHE_ZONE_ID": "00000000000000000000000000000000",
    "CLASSIC_DIRECTORY_PUBLIC_ORIGIN": "https://classic.meta.atrinik.org",
    "GAME_DIRECTORY_PUBLIC_ORIGIN": "https://meta.atrinik.org",
    "PUBLISH_HOSTNAME": "publish.meta.atrinik.org",
    "RENDEZVOUS_HOSTNAME": "rendezvous.meta.atrinik.org",
    "PUBLISH_ENABLED": "disabled",
    "GAME_PUBLISH_ENABLED": "disabled",
    "RENDEZVOUS_ENABLED": "disabled",
    "SOURCE_TAG_KEY_CURRENT_ID": "2026-08-a",
    "SOURCE_TAG_KEY_PREVIOUS_ID": "2026-07-a",
    "LISTING_TTL_SECONDS": "14400",
    "ROUTE_DISABLED_RETRY_SECONDS": "300",
    "PUBLISH_SERVER_DAILY_LIMIT": "48",
    "RENDEZVOUS_SERVER_DAILY_LIMIT": "50",
    "RENDEZVOUS_CLIENT_PAIR_BURST_LIMIT": "20",
    "RENDEZVOUS_CLIENT_PAIR_WINDOW_SECONDS": "60",
    "RENDEZVOUS_CLIENT_PAIR_INITIAL_COOLDOWN_SECONDS": "30",
    "RENDEZVOUS_CLIENT_PAIR_MAXIMUM_COOLDOWN_SECONDS": "900",
    "RENDEZVOUS_CLIENT_PAIR_RESET_SECONDS": "1800",
    "RENDEZVOUS_ACTIVE_CLIENT_LIMIT": "16",
    "RENDEZVOUS_CLIENT_SESSION_SECONDS": "15",
    "DIRECTORY_REFRESH_LEAD_SECONDS": "3600"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 * * * *"]
  },
  "logpush": false,
  "tail_consumers": [],
  "streaming_tail_consumers": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
      "destinations": []
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": false,
      "destinations": []
    }
  }
}
