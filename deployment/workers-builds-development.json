{
  "schemaVersion": 2,
  "provider": "github-actions",
  "repository": "atrinik/metaserver-worker",
  "rootDirectory": "",
  "productionBranch": "main",
  "automaticPush": true,
  "pathIncludes": [
    "*"
  ],
  "pathExcludes": [],
  "installCommand": "env -i HOME=\"$HOME\" PATH=\"$PATH\" npm_config_cache=/tmp/atrinik-npm-cache npm install --global --ignore-scripts npm@11.16.0 && env -i HOME=\"$HOME\" PATH=\"$PATH\" npm_config_cache=/tmp/atrinik-npm-cache npm ci --ignore-scripts",
  "validationCommand": "npm run check",
  "deployCommand": "npm run deploy:development",
  "reviewCommand": "npm run deploy:development:dry-run",
  "buildEnvironment": {
    "SKIP_DEPENDENCY_INSTALL": "1"
  },
  "productionCanaries": [
    {
      "name": "classic-static-directory",
      "command": [
        "python3",
        "scripts/static_origin_canary.py",
        "--profile",
        "classic-v3",
        "--base-url",
        "https://classic.dev.meta.atrinik.org",
        "--alias-prefix",
        "$CLASSIC_DIRECTORY_ALIAS_PREFIX",
        "--json"
      ]
    },
    {
      "name": "game-static-directory",
      "command": [
        "python3",
        "scripts/static_origin_canary.py",
        "--profile",
        "game-v2",
        "--base-url",
        "https://game.dev.meta.atrinik.org",
        "--alias-prefix",
        "$GAME_DIRECTORY_ALIAS_PREFIX",
        "--json"
      ]
    },
    {
      "name": "publisher-service-binding",
      "command": [
        "python3",
        "scripts/dynamic_edge_canary.py",
        "--role",
        "publisher",
        "--base-url",
        "https://publish.dev.meta.atrinik.org",
        "--expected-circuit",
        "$PUBLISH_ENABLED",
        "--disabled-retry-seconds",
        "$ROUTE_DISABLED_RETRY_SECONDS",
        "--json"
      ]
    },
    {
      "name": "rendezvous-service-binding",
      "command": [
        "python3",
        "scripts/dynamic_edge_canary.py",
        "--role",
        "rendezvous",
        "--base-url",
        "https://rendezvous.dev.meta.atrinik.org",
        "--expected-circuit",
        "$RENDEZVOUS_ENABLED",
        "--disabled-retry-seconds",
        "$ROUTE_DISABLED_RETRY_SECONDS",
        "--json"
      ]
    }
  ],
  "toolchain": {
    "node": "24.18.1",
    "npm": "11.16.0",
    "lockfile": "package-lock.json"
  },
  "source": {
    "kind": "successful-main-check",
    "repository": "atrinik/metaserver-worker",
    "workflow": "deploy-development.yml",
    "validationWorkflow": "check.yml",
    "controllerBranch": "main"
  },
  "protectedInputs": {
    "accountVariable": "CLOUDFLARE_ACCOUNT_ID",
    "coreConfigVariable": "ATRINIK_DEVELOPMENT_CORE_CONFIG",
    "publisherConfigVariable": "ATRINIK_DEVELOPMENT_PUBLISHER_CONFIG",
    "rendezvousConfigVariable": "ATRINIK_DEVELOPMENT_RENDEZVOUS_CONFIG"
  },
  "initialBootstrapPredecessor": {
    "requiredPhase": "all-builds-triggers-absent",
    "allowedBindingDelta": [
      {
        "role": "core",
        "name": "CLASSIC_DIRECTORY_CUTOVER_MODE",
        "type": "plain_text",
        "live": "absent",
        "desired": "v4-production"
      },
      {
        "role": "core",
        "name": "GAME_PUBLISH_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "disabled"
      },
      {
        "role": "core",
        "name": "PUBLISH_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "enabled"
      },
      {
        "role": "core",
        "name": "RENDEZVOUS_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "enabled"
      },
      {
        "role": "publisher",
        "name": "GAME_PUBLISH_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "disabled"
      },
      {
        "role": "publisher",
        "name": "PUBLISH_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "enabled"
      },
      {
        "role": "rendezvous",
        "name": "RENDEZVOUS_ENABLED",
        "type": "plain_text",
        "live": "disabled",
        "desired": "enabled"
      }
    ]
  },
  "workers": [
    {
      "role": "core",
      "name": "atrinik-metaserver-development",
      "configuration": "ATRINIK_DEVELOPMENT_CORE_CONFIG",
      "order": 1,
      "directDeploy": true,
      "customDomains": [],
      "requiredVariables": [
        "CLASSIC_DIRECTORY_CUTOVER_MODE",
        "CLASSIC_DIRECTORY_PUBLIC_ORIGIN",
        "DIRECTORY_CACHE_ZONE_ID",
        "DIRECTORY_REFRESH_LEAD_SECONDS",
        "GAME_DIRECTORY_CUTOVER_MODE",
        "GAME_DIRECTORY_PUBLIC_ORIGIN",
        "GAME_PUBLISH_ENABLED",
        "LISTING_TTL_SECONDS",
        "PUBLISH_ENABLED",
        "PUBLISH_HOSTNAME",
        "PUBLISH_SERVER_DAILY_LIMIT",
        "RENDEZVOUS_ACTIVE_CLIENT_LIMIT",
        "RENDEZVOUS_CLIENT_SESSION_SECONDS",
        "RENDEZVOUS_ENABLED",
        "RENDEZVOUS_HOSTNAME",
        "RENDEZVOUS_SERVER_DAILY_LIMIT",
        "ROUTE_DISABLED_RETRY_SECONDS",
        "SOURCE_TAG_KEY_CURRENT_ID",
        "SOURCE_TAG_KEY_PREVIOUS_ID",
        "DEVELOPMENT_MAINTENANCE"
      ],
      "state": [
        "D1:DB",
        "DurableObject:RENDEZVOUS",
        "DurableObject:DIRECTORY_BUILDER",
        "R2:DIRECTORY_GENERATIONS",
        "R2:CLASSIC_DIRECTORY_PUBLIC",
        "R2:GAME_DIRECTORY_PUBLIC",
        "AnalyticsEngine:RENDEZVOUS_METRICS",
        "AnalyticsEngine:DIRECTORY_METRICS",
        "RateLimit:ACCESS_ROUTE_RATE_LIMITER",
        "RateLimit:PUBLISH_IDENTITY_RATE_LIMITER",
        "RateLimit:RENDEZVOUS_SERVER_RATE_LIMITER",
        "DurableObject:DEVELOPMENT_MAINTENANCE_DO"
      ],
      "serviceBindings": [],
      "requiredSecrets": [
        "DIRECTORY_CACHE_PURGE_TOKEN",
        "RENDEZVOUS_HEALTH_EXPORT_TOKEN",
        "SOURCE_TAG_KEY_CURRENT",
        "SOURCE_TAG_KEY_PREVIOUS"
      ]
    },
    {
      "role": "publisher",
      "name": "atrinik-metaserver-development-publisher",
      "configuration": "ATRINIK_DEVELOPMENT_PUBLISHER_CONFIG",
      "order": 2,
      "directDeploy": true,
      "customDomains": [
        "publish.dev.meta.atrinik.org"
      ],
      "requiredVariables": [
        "GAME_PUBLISH_ENABLED",
        "PUBLISH_ENABLED",
        "PUBLISH_HOSTNAME",
        "ROUTE_DISABLED_RETRY_SECONDS"
      ],
      "state": [
        "RateLimit:GLOBAL_RATE_LIMITER"
      ],
      "serviceBindings": [
        "COORDINATOR:atrinik-metaserver-development#PublisherCoordinator"
      ],
      "requiredSecrets": []
    },
    {
      "role": "rendezvous",
      "name": "atrinik-metaserver-development-rendezvous",
      "configuration": "ATRINIK_DEVELOPMENT_RENDEZVOUS_CONFIG",
      "order": 3,
      "directDeploy": true,
      "customDomains": [
        "rendezvous.dev.meta.atrinik.org"
      ],
      "requiredVariables": [
        "RENDEZVOUS_ENABLED",
        "RENDEZVOUS_HOSTNAME",
        "ROUTE_DISABLED_RETRY_SECONDS"
      ],
      "state": [
        "RateLimit:GLOBAL_RATE_LIMITER",
        "RateLimit:RENDEZVOUS_CLIENT_RATE_LIMITER"
      ],
      "serviceBindings": [
        "COORDINATOR:atrinik-metaserver-development#RendezvousCoordinator"
      ],
      "requiredSecrets": []
    }
  ],
  "invariants": {
    "productionWorkersDev": false,
    "productionPreviewUrls": false,
    "migrationPolicy": "exact-ledger-no-automatic-apply",
    "controlPlanePolicy": "automatic-after-live-preflight",
    "deploymentOrder": [
      "core",
      "publisher",
      "rendezvous"
    ],
    "deploymentMode": "direct-100-percent-strict",
    "initialApiHandoff": "automatic-unannotated-api-managed-source-only",
    "buildSerialization": "github-actions-development-concurrency",
    "noOp": "matching-bundles-config-migrations-and-command-contract",
    "recovery": "disabled-circuit-fix-forward-and-exact-current-main-retry"
  },
  "target": "development"
}
