{
  "name": "atrinik-metaserver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:publisher": "wrangler deploy -c wrangler.publisher.jsonc",
    "deploy:rendezvous": "wrangler deploy -c wrangler.rendezvous.jsonc",
    "dev": "wrangler dev",
    "dev:publisher": "wrangler dev -c wrangler.publisher.jsonc -c wrangler.jsonc",
    "dev:rendezvous": "wrangler dev -c wrangler.rendezvous.jsonc -c wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:admin": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "check": "npm run types:generate && npm run types:check && npm run typecheck && npm test && npm run test:admin && npm run test:deployment && npm run test:review && npm run test:provisioning && npm run deploy:dry-run && npm run deploy:dry-run:review-check && npm run test:service-bindings && npm run deploy:production:validate && npm run review:validate && npm run provision:workers-builds:validate",
    "test:deployment": "node --test scripts/test_production_delivery.mjs",
    "test:review": "node --test scripts/test_review_environment.mjs",
    "test:provisioning": "node --test scripts/test_workers_builds_provisioning.mjs",
    "test:service-bindings": "vitest run --config vitest.service.config.ts",
    "deploy:dry-run": "npm run deploy:dry-run:core && npm run deploy:dry-run:publisher && npm run deploy:dry-run:rendezvous",
    "deploy:dry-run:core": "wrangler deploy --dry-run --outdir dist/core -c wrangler.jsonc",
    "deploy:dry-run:publisher": "wrangler deploy --dry-run --outdir dist/publisher -c wrangler.publisher.jsonc",
    "deploy:dry-run:rendezvous": "wrangler deploy --dry-run --outdir dist/rendezvous -c wrangler.rendezvous.jsonc",
    "deploy:dry-run:review-check": "wrangler deploy --dry-run --outdir dist/review-check -c deployment/review-check/wrangler.jsonc",
    "types:generate": "wrangler types worker-runtime.d.ts --include-env=false -c wrangler.jsonc && wrangler types worker-configuration.d.ts --include-runtime=false -c wrangler.jsonc && wrangler types publisher-worker-configuration.d.ts --env-interface PublisherEnv --include-runtime=false -c wrangler.publisher.jsonc -c wrangler.jsonc && wrangler types rendezvous-worker-configuration.d.ts --env-interface RendezvousEnv --include-runtime=false -c wrangler.rendezvous.jsonc -c wrangler.jsonc",
    "types:check": "wrangler types worker-runtime.d.ts --include-env=false --check -c wrangler.jsonc && wrangler types worker-configuration.d.ts --include-runtime=false --check -c wrangler.jsonc && wrangler types publisher-worker-configuration.d.ts --env-interface PublisherEnv --include-runtime=false --check -c wrangler.publisher.jsonc -c wrangler.jsonc && wrangler types rendezvous-worker-configuration.d.ts --env-interface RendezvousEnv --include-runtime=false --check -c wrangler.rendezvous.jsonc -c wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.publisher.json --noEmit && tsc -p tsconfig.rendezvous.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "deploy:production": "node scripts/production-delivery.mjs",
    "deploy:production:dry-run": "node scripts/production-delivery.mjs --dry-run",
    "deploy:production:validate": "node scripts/production-delivery.mjs --validate-only",
    "review:validate": "node scripts/review-environment.mjs --validate-only",
    "review:dry-run": "node scripts/review-environment.mjs --dry-run",
    "review:build": "env -i PATH=\"$PATH\" npm_config_cache=/tmp/atrinik-npm-cache npm install --global --ignore-scripts npm@11.16.0 && env -i PATH=\"$PATH\" npm_config_cache=/tmp/atrinik-npm-cache npm ci --ignore-scripts && npm run review:branch",
    "review:branch": "node scripts/review-environment.mjs --branch",
    "review:reject-sentinel": "node scripts/review-environment.mjs --reject-sentinel",
    "deploy:review-canary": "node scripts/review-environment.mjs --live-not-provisioned",
    "provision:workers-builds:validate": "node scripts/workers-builds-provisioning.mjs --validate-only",
    "provision:workers-builds:dry-run": "node scripts/workers-builds-provisioning.mjs --dry-run",
    "provision:workers-builds:plan-setup": "node scripts/workers-builds-provisioning.mjs --plan-setup",
    "provision:workers-builds:readback": "node scripts/workers-builds-provisioning.mjs --readback",
    "provision:workers-builds:verify-preflight": "node scripts/workers-builds-provisioning.mjs --verify-preflight",
    "provision:workers-builds:materialize-production": "node scripts/workers-builds-provisioning.mjs --materialize-production",
    "provision:workers-builds:verify-staged": "node scripts/workers-builds-provisioning.mjs --verify-staged",
    "provision:workers-builds:verify-review-activation-authority": "node scripts/workers-builds-provisioning.mjs --verify-review-activation-authority",
    "provision:workers-builds:verify-review-activation-authority-proof": "node scripts/workers-builds-provisioning.mjs --verify-review-activation-authority-proof",
    "provision:workers-builds:verify-review-token-rotation-authority": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-authority",
    "provision:workers-builds:verify-review-token-rotation-authority-proof": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-authority-proof",
    "provision:workers-builds:verify-review-token-rotation-authority-proof-historical": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-authority-proof-historical",
    "provision:workers-builds:verify-review-token-rotation-intermediate": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-intermediate",
    "provision:workers-builds:verify-review-token-rotation-provider-normalized-incident": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-provider-normalized-incident",
    "provision:workers-builds:verify-review-token-rotation-provider-peer-normalization": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-provider-peer-normalization",
    "provision:workers-builds:verify-review-token-rotation-unreferenced": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-unreferenced",
    "provision:workers-builds:verify-review-token-rotation-complete": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-complete",
    "provision:workers-builds:verify-review-token-rotation-complete-historical": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-complete-historical",
    "provision:workers-builds:verify-review-token-rotation-rollback-restored": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-rollback-restored",
    "provision:workers-builds:verify-review-token-rotation-rollback-complete": "node scripts/workers-builds-provisioning.mjs --verify-review-token-rotation-rollback-complete",
    "provision:workers-builds:verify-disposable-review-authority": "node scripts/workers-builds-provisioning.mjs --verify-disposable-review-authority",
    "provision:workers-builds:verify-disposable-review-authority-proof": "node scripts/workers-builds-provisioning.mjs --verify-disposable-review-authority-proof",
    "provision:workers-builds:verify-disposable-review-authority-push": "node scripts/workers-builds-provisioning.mjs --verify-disposable-review-authority-push",
    "provision:workers-builds:verify-review-staging-root-create": "node scripts/workers-builds-provisioning.mjs --verify-review-staging-root-create",
    "provision:workers-builds:verify-review-staging-root-activation": "node scripts/workers-builds-provisioning.mjs --verify-review-staging-root-activation",
    "provision:workers-builds:verify-review-staged-environment": "node scripts/workers-builds-provisioning.mjs --verify-review-staged-environment",
    "provision:workers-builds:verify-staged-proof": "node scripts/workers-builds-provisioning.mjs --verify-staged-proof",
    "provision:workers-builds:verify-review-activation": "node scripts/workers-builds-provisioning.mjs --verify-review-activation",
    "provision:workers-builds:verify-production-activation": "node scripts/workers-builds-provisioning.mjs --verify-production-activation",
    "provision:workers-builds:verify-configured": "node scripts/workers-builds-provisioning.mjs --verify-configured"
  },
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@types/node": "^26.1.2",
    "@types/tr46": "5.0.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.119.0"
  },
  "dependencies": {
    "tr46": "6.0.0"
  }
}
